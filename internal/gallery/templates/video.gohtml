{{template "head"}}<title>{{.Gallery}} - Vidéo {{.Number}} - {{.Name}}</title>
</head>
<body>
<header class="video-head">
  <nav class="side">{{if .Prev}}<a class="btn" href="{{.Prev}}" title="vidéo précédente" aria-label="Vidéo précédente">{{template "icon-prev"}}</a>{{end}}</nav>
  <h1 class="video-title"><span class="num">Vidéo {{.Number}}/{{.Total}}</span> <small>{{.Name}}</small></h1>
  <nav class="side">{{if .Next}}<a class="btn" href="{{.Next}}" title="vidéo suivante" aria-label="Vidéo suivante">{{template "icon-next"}}</a>{{end}}</nav>
</header>
<main class="player">
  <video controls preload="metadata" poster="{{.Poster}}" style="--ratio: {{.Ratio}}">
    <source src="{{.Source}}" type="{{.MIME}}">
    Votre navigateur ne supporte pas la balise vidéo.
  </video>
  {{- if .Unsupported}}
  <p class="warn">Cette vidéo est en {{.Unsupported}}, un format que certains navigateurs ou systèmes ne savent pas lire.
    Si l'image reste noire, si seul le son est lu ou si rien ne démarre, <a href="{{.Source}}">ouvrez le fichier</a> avec le lecteur vidéo de votre système.</p>
  {{- end}}
  <p><a class="btn pill" href="{{.Back}}" title="page principale">{{template "icon-grid"}}<span>Retour à la galerie</span></a></p>
  <div class="sheet-row">
    {{if .Prev}}<a class="btn" href="{{.Prev}}" title="vidéo précédente" aria-label="Vidéo précédente">{{template "icon-prev"}}</a>{{else}}<span></span>{{end}}
    <img class="sheet" src="{{.Sheet}}" width="{{.SheetW}}" height="{{.SheetH}}" loading="lazy" alt="Planche de captures de {{.Name}}">
    {{if .Next}}<a class="btn" href="{{.Next}}" title="vidéo suivante" aria-label="Vidéo suivante">{{template "icon-next"}}</a>{{else}}<span></span>{{end}}
  </div>
</main>
{{template "footer" .Version}}</body>
</html>
